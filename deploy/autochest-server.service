[Unit]
Description=AutoChest Matchmaking Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/autochest
# Run with virtual display (headless Love2D)
ExecStart=/usr/bin/xvfb-run -a love server/
# In-app purchases (see deploy/IAP_SETUP.md). Keep the key outside /opt/autochest.
#Environment=IAP_GOOGLE_SERVICE_ACCOUNT=/etc/autochest/play-service-account.json
#Environment=IAP_ANDROID_PACKAGE=com.cmatute.tinyturf
# Testing only -- grants purchases without asking the store:
#Environment=IAP_ALLOW_UNVERIFIED=1
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autochest

[Install]
WantedBy=multi-user.target
